[Unit]
Description=KvirtIO Multipath Watcher Service
After=network.target

[Service]
Type=oneshot
User=kvirtwatch
ExecStart=/usr/local/bin/kvirtio-multipath-watcher.sh
# Hardening del processo locale
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
