# ==============================================================================
# File: /etc/sudoers.d/kvirtwatch (Da posizionare sui 5 nodi KVM SLES)
# Descrizione: Configurazione dei privilegi minimi per l'utente kvirtwatch.
#              Consente il monitoraggio e l'interazione con Pacemaker senza password.
# Autore: Kevin Tafuro
# Progetto: KvirtIO Virtualization
# ==============================================================================

# Nota: per sicurezza i comandi crm_attribute sono bloccati ai soli parametri richiesti.
kvirtwatch ALL=(ALL) NOPASSWD: \
    /usr/sbin/crm_attribute --node node[1-5] --name status-load --update overloaded, \
    /usr/sbin/crm_attribute --node node[1-5] --name status-load --update healthy, \
    /usr/sbin/crm_mon --one-shot --output-as=xml, \
    /usr/sbin/corosync-quorumtool -s, \
    /usr/sbin/stonith_admin --list-registered, \
    /usr/bin/iostat -dx 1 2, \
    /usr/sbin/vgs -o vg_name\,vg_size\,vg_free --units G --nosuffix --noheadings, \
    /usr/sbin/lvs -o lv_name\,vg_name\,lv_size --units G --nosuffix --noheadings, \
    /usr/sbin/multipath -ll, \
    /usr/bin/virsh list --all, \
    /usr/bin/virsh domstate *, \
    /usr/bin/virsh domblklist *, \
    /usr/bin/virsh dominfo *, \
    /usr/bin/virsh define *, \
    /usr/bin/virsh start *, \
    /usr/bin/virsh autostart *, \
    /usr/bin/virsh version --daemon, \
    /usr/bin/virsh migrate *
