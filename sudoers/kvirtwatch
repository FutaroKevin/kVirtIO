# ==============================================================================
# File: /etc/sudoers.d/kvirtwatch (Da posizionare sui 5 nodi KVM SLES)
# Descrizione: Configurazione dei privilegi minimi per l'utente kvirtwatch.
#              Consente il monitoraggio e l'interazione con Pacemaker senza password.
#              Aggiornato per includere i comandi necessari a tutti i watcher:
#              host-watcher, io-watcher, multipath-watcher, network-watcher,
#              cluster-watcher, vm-watcher, console-tracker, vm-create, vm-migrate.
# Autore:  Kevin Tafuro
# Progetto: KvirtIO Virtualization
# ==============================================================================

# --- Pacemaker / Cluster ---
kvirtwatch ALL=(root) NOPASSWD: /usr/sbin/crm_attribute --node * --name status-load --update overloaded
kvirtwatch ALL=(root) NOPASSWD: /usr/sbin/crm_attribute --node * --name status-load --update healthy
kvirtwatch ALL=(root) NOPASSWD: /usr/sbin/crm_mon --one-shot --output-as=xml
kvirtwatch ALL=(root) NOPASSWD: /usr/sbin/crm_mon -1
kvirtwatch ALL=(root) NOPASSWD: /usr/sbin/corosync-quorumtool -s
kvirtwatch ALL=(root) NOPASSWD: /usr/sbin/corosync-cfgtool -s
kvirtwatch ALL=(root) NOPASSWD: /usr/sbin/stonith_admin --list-registered

# --- Storage I/O (io-watcher) ---
kvirtwatch ALL=(root) NOPASSWD: /usr/bin/iostat -dx 1 2

# --- LVM / Volume Group (vm-create, capacity monitoring) ---
kvirtwatch ALL=(root) NOPASSWD: /usr/sbin/vgs -o vg_name\,vg_size\,vg_free --units G --nosuffix --noheadings
kvirtwatch ALL=(root) NOPASSWD: /usr/sbin/lvs -o lv_name\,vg_name\,lv_size --units G --nosuffix --noheadings
kvirtwatch ALL=(root) NOPASSWD: /usr/sbin/lvcreate *
kvirtwatch ALL=(root) NOPASSWD: /usr/sbin/vgchange *

# --- Multipath (multipath-watcher) ---
kvirtwatch ALL=(root) NOPASSWD: /usr/sbin/multipath -ll
kvirtwatch ALL=(root) NOPASSWD: /usr/sbin/multipathd show paths

# --- Network (network-watcher) ---
kvirtwatch ALL=(root) NOPASSWD: /usr/sbin/ip link show
kvirtwatch ALL=(root) NOPASSWD: /usr/sbin/ethtool *
kvirtwatch ALL=(root) NOPASSWD: /usr/sbin/tc qdisc show *

# --- Libvirt / VM lifecycle (vm-watcher, vm-create, vm-migrate, console-tracker) ---
kvirtwatch ALL=(root) NOPASSWD: /usr/bin/virsh list --all
kvirtwatch ALL=(root) NOPASSWD: /usr/bin/virsh list --state-running --name
kvirtwatch ALL=(root) NOPASSWD: /usr/bin/virsh domstate *
kvirtwatch ALL=(root) NOPASSWD: /usr/bin/virsh domblklist *
kvirtwatch ALL=(root) NOPASSWD: /usr/bin/virsh dominfo *
kvirtwatch ALL=(root) NOPASSWD: /usr/bin/virsh domdisplay *
kvirtwatch ALL=(root) NOPASSWD: /usr/bin/virsh define *
kvirtwatch ALL=(root) NOPASSWD: /usr/bin/virsh start *
kvirtwatch ALL=(root) NOPASSWD: /usr/bin/virsh autostart *
kvirtwatch ALL=(root) NOPASSWD: /usr/bin/virsh version --daemon
kvirtwatch ALL=(root) NOPASSWD: /usr/bin/virsh migrate *
kvirtwatch ALL=(root) NOPASSWD: /usr/bin/virsh pool-refresh *

# --- Log collection (log-collector) ---
kvirtwatch ALL=(root) NOPASSWD: /usr/bin/journalctl *
